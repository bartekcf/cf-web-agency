---
import type { projects } from '../data/projects';

interface Props {
  project: (typeof projects)[number];
  size?: 'compact' | 'large';
}

const { project, size = 'compact' } = Astro.props;
---

<div class:list={["project-preview", size === "large" && "project-preview--large", `project-preview--${project.slug}`]} style={`--preview-accent: ${project.accent}`} aria-hidden="true">
  <div class="preview-browser">
    <div class="preview-chrome"><span>{project.name}</span><span>Koncepcja</span></div>
    <div class="preview-screen">
      <div class="preview-text">
        <p class="preview-label">{project.label}</p>
        <p class="preview-title">{project.name}</p>
        <p class="preview-description">{project.description}</p>
        <span class="preview-action">Poznaj ofertę</span>
      </div>
      <div class="preview-shape"></div>
    </div>
  </div>
</div>
