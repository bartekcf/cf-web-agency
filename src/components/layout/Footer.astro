---
import { ArrowUpRight } from '@lucide/astro';
import { site } from '../../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 17.5 12 5l6 12.5M8 14h8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <span>{site.name}</span>
        </a>
        <p>{site.description}</p>
      </div>
      <div class="footer-column">
        <h2>Strony</h2>
        <nav class="footer-links" aria-label="Oferta i realizacje">
          <a href="/oferta/">Oferta i pakiety</a>
          <a href="/realizacje/">Projekty koncepcyjne</a>
          <a href="/jak-to-dziala/">Jak to działa</a>
        </nav>
      </div>
      <div class="footer-column">
        <h2>Kontakt</h2>
        <nav class="footer-links" aria-label="Kontakt i zamówienie">
          <a href="/kontakt/">Zapytaj o stronę <ArrowUpRight size={14} aria-hidden="true" /></a>
          {site.contactEmail && <a class="footer-contact" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
          {site.phone && <a class="footer-contact" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>}
          {site.socialLinks.map((social) => <a class="footer-contact" href={social.href}>{social.label}</a>)}
        </nav>
      </div>
      <div class="footer-column">
        <h2>Informacje</h2>
        <nav class="footer-links" aria-label="Dokumenty">
          <a href="/polityka-prywatnosci/">Polityka prywatności</a>
          <a href="/regulamin/">Regulamin</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Strony internetowe dla małych firm</span>
    </div>
  </div>
</footer>
