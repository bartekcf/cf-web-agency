---
import { ArrowUpRight } from '@lucide/astro';
import { site } from '../../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">t.</span>
          <span>{site.name}</span>
        </a>
        <p>{site.description}</p>
      </div>
      <div class="footer-column">
        <h2>Strony</h2>
        <nav class="footer-links" aria-label="Oferta i realizacje">
          <a href="/oferta/">Oferta</a>
          <a href="/realizacje/">Projekty koncepcyjne</a>
          <a href="/jak-to-dziala/">Jak to działa</a>
        </nav>
      </div>
      <div class="footer-column">
        <h2>Kontakt</h2>
        <nav class="footer-links" aria-label="Kontakt">
          <a href="/kontakt/#formularz">Poproś o telefon <ArrowUpRight size={14} aria-hidden="true" /></a>
          {site.contactEmail && <a class="footer-contact" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
          {site.phone && <a class="footer-contact" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>}
          {site.socialLinks.map((social) => <a class="footer-contact" href={social.href}>{social.label}</a>)}
        </nav>
      </div>
      <div class="footer-column">
        <h2>Informacje</h2>
        <nav class="footer-links" aria-label="Dokumenty">
          <a href="/polityka-prywatnosci/">Polityka prywatności</a>
          <a href="/regulamin/">Regulamin</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Strony i proste aplikacje dla małych firm</span>
    </div>
  </div>
</footer>
