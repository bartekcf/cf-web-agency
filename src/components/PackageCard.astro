---
import { ArrowRight, Check } from '@lucide/astro';
import { formatPrice } from '../lib/formatting';
import type { packages } from '../data/packages';

interface Props {
  package: (typeof packages)[number];
}

const { package: item } = Astro.props;
---

<article class:list={["card", "package-card", item.featured && "package-card--featured"]}>
  {item.featured && <span class="tag" style="border-color: #d4ccf4; background: #f4f1ff; color: var(--accent-dark);">Polecany pakiet</span>}
  <h3>{item.name}</h3>
  <div class="package-price"><strong>{formatPrice(item.priceFrom)}</strong><span>i więcej</span></div>
  <p class="package-summary">{item.summary}</p>
  <ul class="package-list">
    {item.included.slice(0, 6).map((feature) => <li><Check size={16} aria-hidden="true" />{feature}</li>)}
  </ul>
  <a class:list={["button", item.featured ? "button-primary" : "button-secondary"]} href={`/oferta/${item.slug}/`}>
    Zobacz zakres <ArrowRight size={16} aria-hidden="true" />
  </a>
  <p class="package-caveat">Domena i hosting mogą wiązać się z dodatkowymi opłatami. Cena końcowa zależy od zakresu.</p>
</article>
