---
import { ArrowRight, Check } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  { title: 'Rozmowa i ustalenia', text: 'Opowiadasz o firmie lub procesie, który chcesz usprawnić. Pomagamy określić cel i potrzebne materiały.' },
  { title: 'Propozycja zakresu i ceny', text: 'Przedstawiamy, co przygotujemy, jak będzie przebiegać praca i jaki jest koszt. Zaczynamy po uzgodnieniu warunków.' },
  { title: 'Wykonanie i podgląd', text: 'Przygotowujemy rozwiązanie i pokazujemy Ci wersję do sprawdzenia. Uwagi omawiamy w ramach ustalonego zakresu.' },
  { title: 'Akceptacja i uruchomienie', text: 'Po uzgodnieniu poprawek przygotowujemy publikację, pomagamy z domeną i hostingiem oraz pokazujemy, jak korzystać z gotowego rozwiązania.' },
];
const materials = ['Nazwa firmy i krótki opis działalności', 'Lista usług, produktów lub procesu do usprawnienia', 'Logo i kolory marki, jeśli już je masz', 'Zdjęcia własne lub przykłady stylu, który Ci odpowiada', 'Dane kontaktowe, adres i godziny otwarcia — jeśli są potrzebne', 'Informacja o domenie i hostingu, jeśli zostały już wykupione'];
---

<BaseLayout title="Jak wygląda współpraca" description="Poznaj etapy tworzenia strony lub prostej aplikacji, materiały potrzebne na start oraz sposób publikacji i przekazania gotowego rozwiązania." canonicalPath="/jak-to-dziala/">
  <main id="main">
    <section class="article-hero">
      <div class="container">
        <p class="eyebrow">Współpraca krok po kroku</p>
        <h1>Ty znasz swój biznes. My prowadzimy przez resztę.</h1>
        <p>Nie musisz znać się na technologii. Ustalamy zakres prostym językiem, pokazujemy postęp i pomagamy uruchomić gotowe rozwiązanie — stronę albo prostą aplikację.</p>
      </div>
    </section>

    <section class="section process-detail" aria-labelledby="steps-title">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Przejrzysta droga</p><h2 id="steps-title">Od rozmowy do uruchomienia</h2><p>Dokładny harmonogram zależy od zakresu projektu i dostępności materiałów. Potwierdzamy go przed rozpoczęciem prac.</p></div>
        <ol class="timeline">
          {steps.map((step, index) => <li><span class="timeline-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="section materials-section" aria-labelledby="materials-title">
      <div class="container materials-grid">
        <div><p class="eyebrow">Przygotuj, co już masz</p><h2 id="materials-title">Nie potrzebujesz gotowego briefu.</h2><p class="muted">Zaczynamy od prostych informacji o firmie. Nie musisz mieć wszystkiego — przejdziemy przez braki razem.</p></div>
        <ul class="materials-list">{materials.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}</ul>
      </div>
    </section>

    <section class="section handover-section" aria-labelledby="handover-title">
      <div class="container handover-grid">
        <div><p class="eyebrow">Po uruchomieniu</p><h2 id="handover-title">Wiesz, co otrzymujesz.</h2><p>Przed rozpoczęciem uzgadniamy sposób publikacji, dostępów i przekazania plików. Ustalamy też, które elementy możesz zmieniać samodzielnie, a przy których potrzebujesz naszej pomocy.</p></div>
        <div class="handover-card card"><h3>Po wdrożeniu</h3><ul><li>Informacje o uruchomionym rozwiązaniu</li><li>Uzgodnione dostępy i wskazówki dotyczące hostingu</li><li>Krótkie wprowadzenie do gotowej strony lub aplikacji</li><li>Możliwość uzgodnienia dalszego utrzymania</li></ul></div>
      </div>
    </section>

    <section class="section"><div class="container"><div class="cta-band"><div class="cta-band-inner"><div><p class="eyebrow">Możemy zacząć od rozmowy</p><h2>Masz pytanie o swoją sytuację?</h2><p>Opisz, czego potrzebujesz — podpowiemy, jaki może być kolejny krok.</p></div><a class="button" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={17} aria-hidden="true" /></a></div></div></div></section>
  </main>
</BaseLayout>

<style>
  .process-detail { background: var(--surface); }
  .timeline { max-width: 850px; margin: 3rem auto 0; padding: 0; list-style: none; }
  .timeline li { position: relative; display: grid; grid-template-columns: 3.2rem 1fr; gap: 1.3rem; padding: 0 0 2.2rem; }
  .timeline li:not(:last-child)::before { position: absolute; top: 3rem; bottom: .3rem; left: 1.45rem; width: 1px; background: var(--line); content: ""; }
  .timeline-number { position: relative; z-index: 1; display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid var(--accent); background: var(--accent-soft); color: var(--accent-dark); font-size: .82rem; font-weight: 800; }
  .timeline h3 { margin: .25rem 0 .45rem; font-size: 1.2rem; letter-spacing: -.035em; }
  .timeline p { max-width: 690px; margin: 0; color: var(--muted); }
  .materials-section { background: var(--surface-soft); }
  .materials-grid, .handover-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: start; gap: clamp(2rem, 8vw, 7rem); }
  .materials-grid h2, .handover-grid h2 { max-width: 12ch; font-size: clamp(2.1rem, 4vw, 3.4rem); line-height: 1.04; letter-spacing: -.06em; }
  .materials-grid > div > p:not(.eyebrow), .handover-grid > div > p:not(.eyebrow) { color: var(--muted); }
  .materials-list { display: grid; gap: .85rem; margin: 0; padding: 0; list-style: none; }
  .materials-list li { display: flex; align-items: flex-start; gap: .7rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .materials-list svg { flex: 0 0 auto; color: var(--accent); }
  .handover-card { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .handover-card h3 { font-size: 1.35rem; }
  .handover-card ul { display: grid; gap: .65rem; margin-bottom: 0; padding-left: 1.2rem; color: var(--muted); }
  @media (max-width: 760px) { .materials-grid, .handover-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
