---
import { ArrowRight, Mail, MessageCircle, PhoneCall } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site } from '../data/site';
---

<BaseLayout title="Kontakt — poproś o telefon" description="Poproś o telefon w sprawie firmowej strony lub prostej aplikacji. Podaj numer, a resztę ustalimy podczas rozmowy." canonicalPath="/kontakt/">
  <main id="main">
    <section class="section contact-page">
      <div class="container form-layout">
        <aside class="form-aside">
          <p class="eyebrow">Kontakt</p>
          <h1>Porozmawiajmy o tym, czego potrzebujesz.</h1>
          <p class="muted">Wystarczy numer telefonu. Opowiesz nam o firmie lub zadaniu, które chcesz usprawnić — wspólnie ustalimy kolejny krok.</p>
          <div class="contact-notes">
            <div><span class="contact-icon"><MessageCircle size={18} aria-hidden="true" /></span><p><strong>Bez zobowiązań</strong><span>Prośba o kontakt nie oznacza zamówienia ani płatności.</span></p></div>
            {site.phone && <div><span class="contact-icon"><PhoneCall size={18} aria-hidden="true" /></span><p><strong>Wolisz zadzwonić?</strong><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></p></div>}
            {site.contactEmail && <div><span class="contact-icon"><Mail size={18} aria-hidden="true" /></span><p><strong>Wolisz napisać?</strong><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p></div>}
          </div>
          <a class="contact-process-link" href="/jak-to-dziala/">Zobacz, jak przebiega współpraca <ArrowRight size={15} aria-hidden="true" /></a>
        </aside>
        <ContactForm />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page { padding-block: clamp(3rem, 7vw, 6rem); }
  .form-aside > p:not(.eyebrow) { max-width: 400px; }
  .contact-notes { display: grid; gap: 1.1rem; margin: 2rem 0; }
  .contact-notes > div { display: flex; align-items: flex-start; gap: .8rem; }
  .contact-icon { display: grid; width: 2.35rem; height: 2.35rem; flex: 0 0 auto; place-items: center; border: 1px solid var(--accent); background: var(--accent-soft); color: var(--accent); }
  .contact-notes p { display: grid; gap: .13rem; margin: 0; }
  .contact-notes strong { font-size: .88rem; }
  .contact-notes span, .contact-notes a { color: var(--muted); font-size: .83rem; }
  .contact-notes a { width: fit-content; }
  .contact-process-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--accent-dark); font-size: .87rem; font-weight: 700; }
</style>
