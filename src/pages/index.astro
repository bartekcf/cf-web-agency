---
import { ArrowRight, Check, MousePointer2, ShieldCheck, Smartphone } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import PackageCard from '../components/PackageCard.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { faqs, additionalServices } from '../data/faq';
import { packages } from '../data/packages';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { formatPrice } from '../lib/formatting';

const featuredProjects = projects.slice(0, 3);
const advantages = [
  { title: 'Jasna cena przed startem', description: 'Wiesz, co obejmuje pakiet, a dodatki wyceniamy przed rozpoczęciem prac.' },
  { title: 'Działa na każdym ekranie', description: 'Projektujemy z myślą o telefonie, tablecie i komputerze.' },
  { title: 'Pomoc od początku do publikacji', description: 'Prowadzimy przez wybór hostingu, domenę, HTTPS i uruchomienie.' },
];
const audiences = [
  { title: 'Usługi lokalne', description: 'Telefon, obszar działania i oferta — łatwe do znalezienia dla klientów z okolicy.' },
  { title: 'Gastronomia', description: 'Menu, godziny i adres w czytelnym miejscu, także na ekranie telefonu.' },
  { title: 'Salony beauty', description: 'Spokojna prezentacja usług, wnętrza i sposobu umówienia wizyty.' },
  { title: 'Budownictwo i remonty', description: 'Zakres prac, zdjęcia realizacji i prosty kontakt bez szukania po stronie.' },
  { title: 'Freelancerzy', description: 'Przejrzysta oferta i portfolio, które pokazuje, czym możesz pomóc.' },
  { title: 'Nowe firmy', description: 'Solidny punkt startu online, kiedy dopiero budujesz rozpoznawalność.' },
];
---

<BaseLayout
  title="Strony internetowe dla małych firm"
  description={site.description}
  canonicalPath="/"
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Strony WWW dla małych firm</p>
          <h1 id="hero-title">Strona, która wygląda jak <em>Twoja firma.</em></h1>
          <p>Projektujemy i uruchamiamy strony dla małych firm — od pierwszego pomysłu po domenę i publikację. Bez technicznego żargonu, z jasną ceną.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/oferta/">Sprawdź pakiety <ArrowRight size={17} aria-hidden="true" /></a>
            <a class="button button-secondary" href="/kontakt/">Zamów swoją stronę</a>
          </div>
          <p class="hero-price"><span class="hero-price-label">Pakiety od</span><strong>{formatPrice(packages[0].priceFrom)}</strong><span class="hero-price-note">Domena i hosting mogą być dodatkowo płatne</span></p>
          <ul class="hero-points">
            <li><Check size={16} aria-hidden="true" /> Bez wiedzy technicznej</li>
            <li><Check size={16} aria-hidden="true" /> Jasny zakres i cena</li>
            <li><Check size={16} aria-hidden="true" /> Pomoc przy publikacji</li>
          </ul>
        </div>
        <div class="hero-art" aria-label="Koncepcyjny projekt strony internetowej dla salonu barber" role="img">
          <div class="hero-browser">
            <div class="browser-bar"><span class="mock-brand">NOŻYCZKA</span><span class="browser-address">STUDIO BARBER · KRAKÓW</span></div>
            <div class="mock-site">
              <div class="mock-copy">
                <span class="mock-kicker">PRZYKŁADOWY PROJEKT · BARBER</span>
                <h2>Rzemiosło, które widać.</h2>
                <p>Klasyczne cięcie. Dobra rozmowa. Miejsce dla Ciebie.</p>
                <span class="mock-button">Poznaj studio</span>
              </div>
              <div class="mock-visual"><span class="mock-nav">BARBER <span>KRAKÓW</span></span></div>
            </div>
          </div>
          <div class="hero-sticker"><span class="hero-sticker-mark" aria-hidden="true">01</span><span><strong>Koncepcja strony</strong><span>Barber / Kraków</span></span></div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="W każdym pakiecie">
      <div class="container trust-inner">
        <span class="trust-note">W każdym pakiecie:</span>
        <ul class="trust-list">
          <li><Check size={15} aria-hidden="true" /> Projekt responsywny</li>
          <li><Check size={15} aria-hidden="true" /> Pomoc z publikacją</li>
          <li><Check size={15} aria-hidden="true" /> Podstawowe SEO</li>
          <li><Check size={15} aria-hidden="true" /> Krótkie wprowadzenie</li>
        </ul>
      </div>
    </section>

    <section class="section benefit-section" aria-labelledby="benefit-title">
      <div class="container benefit-grid">
        <div class="benefit-intro" data-reveal>
          <p class="eyebrow">Prosto, od pomysłu do publikacji</p>
          <h2 id="benefit-title">Nie musisz znać się na technologii.</h2>
          <p>Ty najlepiej znasz swoją firmę. My przekładamy to na przejrzystą stronę i pomagamy przejść przez techniczne kroki.</p>
          <a class="text-link" href="/jak-to-dziala/">Zobacz, jak wygląda współpraca <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <div class="benefit-list">
          {advantages.map((item, index) => (
            <article class="benefit-row" data-reveal>
              <span class="benefit-icon">{index === 0 && <ShieldCheck size={20} aria-hidden="true" />}{index === 1 && <Smartphone size={20} aria-hidden="true" />}{index === 2 && <MousePointer2 size={20} aria-hidden="true" />}</span>
              <div><span class="benefit-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="pakiety" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Przejrzyste pakiety</p>
          <h2 id="pricing-title">Wybierz dobry punkt startu.</h2>
          <p>Kwoty zaczynają się od wskazanej ceny bazowej. Jeśli potrzebujesz dodatkowego zakresu, poznasz wycenę przed podjęciem decyzji.</p>
        </div>
        <div class="package-grid">
          {packages.map((item) => <PackageCard package={item} />)}
        </div>
        <p class="pricing-note">Domena i hosting nie są automatycznie wliczone — ich koszt zależy od wybranego dostawcy. <a href="/oferta/">Zobacz pełne porównanie pakietów</a>.</p>
      </div>
    </section>

    <section class="section process-section" aria-labelledby="process-title">
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Pięć prostych kroków</p>
          <h2 id="process-title">Od pierwszej rozmowy do gotowej strony.</h2>
          <p>Przechodzimy przez kolejne etapy razem — bez potrzeby samodzielnego rozwiązywania technicznych problemów.</p>
        </div>
        <div class="steps-grid">
          {[
            ['01', 'Wybierasz pakiet', 'Ustalamy, jakiej strony potrzebujesz i co ma się na niej znaleźć.'],
            ['02', 'Przekazujesz materiały', 'Logo, zdjęcia i informacje o firmie — podpowiemy, czego brakuje.'],
            ['03', 'Przygotowujemy stronę', 'Tworzymy projekt i pokazujemy Ci wersję do sprawdzenia.'],
            ['04', 'Publikujemy', 'Pomagamy skonfigurować domenę, hosting i uruchamiamy stronę.'],
            ['05', 'Pokazujemy obsługę', 'Przekazujemy ustalone dostępy i krótkie wprowadzenie do strony.'],
          ].map(([number, title, description]) => (
            <article class="step" data-reveal><span class="step-number">{number}</span><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>
        <a class="process-link" href="/jak-to-dziala/">Więcej o przebiegu współpracy <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="section portfolio-section" aria-labelledby="portfolio-title">
      <div class="container">
        <div class="portfolio-heading" data-reveal>
          <div><p class="eyebrow">Kierunki wizualne</p><h2 id="portfolio-title">Zobacz, jak może wyglądać Twoja branża.</h2><p>To przykładowe koncepcje przygotowane jako demonstracja możliwości — nie są realizacjami zleceń.</p></div>
          <a class="button button-secondary" href="/realizacje/">Wszystkie koncepcje <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <article class="card project-card" data-reveal>
              <a class="project-card-link" href={`/realizacje/${project.slug}/`} aria-label={`Zobacz demonstracyjną koncepcję ${project.name}`}>
                <ProjectPreview project={project} />
                <div class="project-info"><div class="project-info-top"><div><span class="eyebrow">{project.category} · Koncepcja</span><h3>{project.name}</h3></div><span class="project-arrow"><ArrowRight size={16} aria-hidden="true" /></span></div><p>{project.description}</p></div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section audience-section" aria-labelledby="audience-title">
      <div class="container audience-grid">
        <div class="audience-intro" data-reveal>
          <p class="eyebrow">Dla kogo tworzymy</p>
          <h2 id="audience-title">Dobra strona zaczyna się od Twoich klientów.</h2>
          <p>Projekt układamy wokół informacji, których szukają osoby zainteresowane Twoją ofertą.</p>
          <a class="text-link" href="/kontakt/">Opowiedz o swojej firmie <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <ul class="audience-list">
          {audiences.map((item, index) => (
            <li data-reveal><span class="audience-index">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><ArrowRight size={17} aria-hidden="true" /></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section addons-section" aria-labelledby="addons-title">
      <div class="container addons-grid">
        <div class="addons-intro" data-reveal><p class="eyebrow">Kiedy potrzebujesz więcej</p><h2 id="addons-title">Rozwijaj stronę w swoim tempie.</h2><p>Możesz wrócić po dodatkowe prace już po uruchomieniu. Zakres i cena są ustalane indywidualnie.</p><a class="text-link" href="/oferta/">Poznaj usługi dodatkowe <ArrowRight size={16} aria-hidden="true" /></a></div>
        <div class="addons-list">
          {additionalServices.map((service) => <article data-reveal><span class="addon-plus" aria-hidden="true">+</span><div><h3>{service.title}</h3><p>{service.description}</p></div><span class="tag">Wycena indywidualna</span></article>)}
        </div>
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <div class="faq-intro" data-reveal><p class="eyebrow">Masz pytania?</p><h2 id="faq-title">Konkretne odpowiedzi przed startem.</h2><p>Jeśli czegoś brakuje, opisz sytuację w formularzu — nie musisz znać technicznych nazw.</p><a class="text-link" href="/kontakt/">Zadaj własne pytanie <ArrowRight size={16} aria-hidden="true" /></a></div>
        <FAQList items={faqs} />
      </div>
    </section>

    <section class="section final-section">
      <div class="container"><div class="cta-band" data-reveal><div class="cta-band-inner"><div><p class="eyebrow">Gotowy pierwszy krok</p><h2>Masz firmę. Pomożemy Ci zaistnieć w internecie.</h2><p>Opowiedz, czego potrzebujesz. Wspólnie dobierzemy rozsądny zakres i odpowiemy na pytania.</p></div><a class="button" href="/kontakt/">Zamów swoją stronę <ArrowRight size={17} aria-hidden="true" /></a></div></div></div>
    </section>
  </main>
</BaseLayout>

<style>
  .benefit-section { background: var(--forest); color: var(--surface); }
  .benefit-section .eyebrow { color: var(--lime); }
  .benefit-section .benefit-intro h2 { color: var(--surface); }
  .benefit-section .benefit-intro > p:not(.eyebrow), .benefit-section .benefit-row p { color: rgba(251,249,242,.76); }
  .benefit-section .text-link { color: var(--lime); }
  .benefit-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 10vw, 8rem); align-items: start; }
  .benefit-intro { position: sticky; top: 8rem; }
  .benefit-intro h2, .audience-intro h2, .addons-intro h2, .faq-intro h2 { max-width: 12ch; margin-bottom: 1rem; font-size: clamp(2.2rem, 4.2vw, 3.7rem); line-height: 1.02; letter-spacing: -.065em; }
  .benefit-intro > p:not(.eyebrow), .audience-intro > p:not(.eyebrow), .addons-intro > p:not(.eyebrow), .faq-intro > p:not(.eyebrow) { max-width: 440px; color: var(--muted); }
  .text-link, .process-link { display: inline-flex; align-items: center; gap: .5rem; color: var(--accent-dark); font-size: .9rem; font-weight: 720; text-decoration: none; }
  .text-link:hover, .process-link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .benefit-list { border-top: 1px solid rgba(251,249,242,.25); }
  .benefit-row { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; padding: 1.6rem 0; border-bottom: 1px solid rgba(251,249,242,.25); }
  .benefit-icon { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border: 1px solid var(--lime); background: var(--lime); color: var(--forest); }
  .benefit-number { color: rgba(251,249,242,.62); font-size: .7rem; font-weight: 700; letter-spacing: .1em; }
  .benefit-row h3 { margin: .2rem 0 .4rem; font-size: 1.17rem; letter-spacing: -.03em; }
  .benefit-row p { max-width: 520px; margin: 0; color: var(--muted); font-size: .9rem; }
  .pricing-section { background: var(--surface); }
  .pricing-note { margin: 1.5rem 0 0; color: var(--muted); font-size: .82rem; }
  .pricing-note a { color: var(--accent-dark); }
  .process-section { background: var(--surface-soft); }
  .process-section .section-heading { max-width: 650px; }
  .process-link { margin-top: 2rem; }
  .portfolio-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .portfolio-heading > div { max-width: 680px; }
  .portfolio-heading h2 { margin: 0 0 .75rem; font-size: clamp(2rem, 4.2vw, 3.5rem); line-height: 1.05; letter-spacing: -.06em; }
  .portfolio-heading p:not(.eyebrow) { margin: 0; color: var(--muted); }
  .portfolio-heading .button { flex-shrink: 0; }
  .portfolio-section .project-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; gap: 1.25rem; }
  .portfolio-section .project-card:nth-child(1) { grid-column: span 7; }
  .portfolio-section .project-card:nth-child(2) { grid-column: span 5; margin-top: 5rem; }
  .portfolio-section .project-card:nth-child(3) { grid-column: 4 / span 6; margin-top: -1.5rem; }
  .portfolio-section .project-card:nth-child(1) .project-preview { min-height: 320px; }
  .portfolio-section .project-card:nth-child(2) .project-preview { min-height: 245px; }
  .portfolio-section .project-card:nth-child(3) .project-preview { min-height: 275px; }
  .audience-section { background: var(--surface); }
  .audience-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(3rem, 9vw, 7rem); align-items: start; }
  .audience-intro { position: sticky; top: 8rem; }
  .audience-list { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .audience-list li { display: grid; grid-template-columns: 2rem 1fr auto; align-items: start; gap: .8rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line); }
  .audience-index { padding-top: .15rem; color: var(--accent-dark); font-size: .72rem; font-weight: 800; }
  .audience-list h3 { margin: 0 0 .3rem; font-size: 1rem; }
  .audience-list p { max-width: 490px; margin: 0; color: var(--muted); font-size: .85rem; }
  .audience-list svg { margin-top: .2rem; color: var(--muted); }
  .addons-section { background: var(--surface-soft); }
  .addons-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .addons-list { border-top: 1px solid var(--line); }
  .addons-list article { display: grid; grid-template-columns: 2rem 1fr auto; align-items: start; gap: .9rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .addon-plus { display: grid; width: 1.7rem; height: 1.7rem; place-items: center; border: 1px solid var(--accent); color: var(--accent); font-size: 1.1rem; }
  .addons-list h3 { margin: .1rem 0 .25rem; font-size: .96rem; }
  .addons-list p { max-width: 390px; margin: 0; color: var(--muted); font-size: .83rem; }
  .addons-list .tag { white-space: nowrap; }
  .faq-section { background: var(--surface); }
  .faq-layout { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .faq-intro { position: sticky; top: 8rem; }
  .final-section { padding-top: 1rem; }
  @media (max-width: 850px) {
    .benefit-grid, .audience-grid, .addons-grid, .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .benefit-intro, .audience-intro, .faq-intro { position: static; }
    .benefit-intro h2, .audience-intro h2, .addons-intro h2, .faq-intro h2 { max-width: 15ch; }
  }
  @media (max-width: 640px) {
    .portfolio-heading { align-items: flex-start; flex-direction: column; }
    .addons-list article { grid-template-columns: 2rem 1fr; }
    .addons-list .tag { grid-column: 2; }
    .audience-list li { grid-template-columns: 1.6rem 1fr auto; gap: .55rem; }
  }
  @media (max-width: 850px) {
    .portfolio-section .project-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .portfolio-section .project-card:nth-child(1) { grid-column: span 4; }
    .portfolio-section .project-card:nth-child(2) { grid-column: span 2; margin-top: 3rem; }
    .portfolio-section .project-card:nth-child(3) { grid-column: 2 / span 4; margin-top: -1rem; }
  }
  @media (max-width: 640px) {
    .portfolio-section .project-grid { grid-template-columns: 1fr; }
    .portfolio-section .project-card:nth-child(1), .portfolio-section .project-card:nth-child(2), .portfolio-section .project-card:nth-child(3) { grid-column: auto; margin-top: 0; }
    .portfolio-section .project-card .project-preview { min-height: 230px; }
  }
</style>
