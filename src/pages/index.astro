---
import { ArrowRight, Check, PhoneCall, ShieldCheck, Smartphone } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import OfferCard from '../components/OfferCard.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { faqs, offerFaqs } from '../data/faq';
import { offers } from '../data/offers';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featuredProjects = projects.slice(0, 3);
const homeFaqs = [...offerFaqs.slice(0, 3), ...faqs.slice(0, 2)];
const collaboration = [
  { title: 'Pomoc z treścią', description: 'Opowiadasz o firmie lub zadaniu. Pomagamy zebrać potrzebne informacje i ułożyć je w czytelny sposób.' },
  { title: 'Wykonanie rozwiązania', description: 'Przygotowujemy stronę albo proste narzędzie w zakresie uzgodnionym przed rozpoczęciem prac.' },
  { title: 'Domena i hosting', description: 'Zajmujemy się wyborem i konfiguracją, a domenę rejestrujemy na Twoje dane jako abonenta. Nie musisz sam szukać dostawcy ani konfigurować usług.' },
  { title: 'Publikacja i wprowadzenie', description: 'Uruchamiamy zaakceptowane rozwiązanie i pokazujemy, jak z niego korzystać.' },
];
const steps = [
  ['01', 'Rozmowa i ustalenia', 'Opowiadasz, czego potrzebuje Twoja firma.'],
  ['02', 'Zakres i cena', 'Przedstawiamy propozycję do akceptacji.'],
  ['03', 'Wykonanie i podgląd', 'Przygotowujemy rozwiązanie i pokazujemy Ci wersję do sprawdzenia.'],
  ['04', 'Uwagi i uruchomienie', 'Uzgadniamy zmiany, akceptujesz wynik, a my pomagamy go uruchomić.'],
];
---

<BaseLayout
  title="Strony i proste aplikacje dla małych firm"
  description={site.description}
  canonicalPath="/"
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Strony i proste aplikacje dla małych firm</p>
          <h1 id="hero-title">Strona Twojej firmy. <em>Resztę ogarniemy za Ciebie.</em></h1>
          <p>Tworzymy strony i proste narzędzia do pracy. Pomożemy zebrać treści i ustalić zakres. Nie musisz samodzielnie szukać ani konfigurować domeny i hostingu — przeprowadzimy Cię przez te kroki i uruchomimy gotowe rozwiązanie.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={17} aria-hidden="true" /></a>
            {site.phone
              ? <a class="button button-secondary" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}><PhoneCall size={16} aria-hidden="true" /> Zadzwoń: {site.phone}</a>
              : <a class="button button-secondary" href="/oferta/">Poznaj ofertę</a>}
          </div>
          <p class="hero-price"><strong>Cena po ustaleniu zakresu</strong><span>Bez technicznego żargonu i bez płatnego zamówienia przez formularz.</span></p>
          <ul class="hero-points">
            <li><Check size={16} aria-hidden="true" /> Strona albo proste narzędzie</li>
            <li><Check size={16} aria-hidden="true" /> Pomoc od treści po publikację</li>
            <li><Check size={16} aria-hidden="true" /> Rozmowa przed wyceną</li>
          </ul>
        </div>
        <div class="hero-art" aria-label="Demonstracyjny projekt strony internetowej dla salonu barber" role="img">
          <div class="hero-browser">
            <div class="browser-bar"><span class="mock-brand">NOŻYCZKA</span><span class="browser-address">DEMO · STUDIO BARBER</span></div>
            <div class="mock-site">
              <div class="mock-copy">
                <span class="mock-kicker">KONCEPCJA STRONY · BARBER</span>
                <h2>Rzemiosło, które widać.</h2>
                <p>Klasyczne cięcie. Dobra rozmowa. Miejsce dla Ciebie.</p>
                <span class="mock-button">Poznaj studio</span>
              </div>
              <div class="mock-visual"><span class="mock-nav">BARBER <span>KONCEPCJA</span></span></div>
            </div>
          </div>
          <div class="hero-sticker"><span class="hero-sticker-mark" aria-hidden="true">01</span><span><strong>Projekt demonstracyjny</strong><span>Barber / koncepcja</span></span></div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Zakres współpracy">
      <div class="container trust-inner">
        <span class="trust-note">Od pomysłu do uruchomienia</span>
        <ul class="trust-list">
          <li><Check size={15} aria-hidden="true" /> Ustalenie zakresu</li>
          <li><Check size={15} aria-hidden="true" /> Pomoc z materiałami</li>
          <li><Check size={15} aria-hidden="true" /> Domena i hosting</li>
          <li><Check size={15} aria-hidden="true" /> Publikacja</li>
        </ul>
      </div>
    </section>

    <section class="section offer-section" id="oferta" aria-labelledby="offer-title">
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Dwa kierunki, jeden prosty kontakt</p>
          <h2 id="offer-title">Co chcesz ułatwić swojej firmie?</h2>
          <p>Wybierz punkt wyjścia albo zostaw decyzję nam. Zakres i cena są ustalane przed rozpoczęciem prac.</p>
        </div>
        <div class="offer-grid">
          {offers.map((offer) => <OfferCard offer={offer} />)}
        </div>
      </div>
    </section>

    <section class="section benefit-section" aria-labelledby="benefit-title">
      <div class="container benefit-grid">
        <div class="benefit-intro" data-reveal>
          <p class="eyebrow">Kompleksowa pomoc</p>
          <h2 id="benefit-title">Nie musisz znać się na technologii.</h2>
          <p>Ty znasz swoją firmę. My pomagamy przejść od pomysłu do gotowego rozwiązania.</p>
          <a class="text-link" href="/jak-to-dziala/">Zobacz, jak wygląda współpraca <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <div class="benefit-list">
          {collaboration.map((item, index) => (
            <article class="benefit-row" data-reveal>
              <span class="benefit-icon">{index === 0 && <ShieldCheck size={20} aria-hidden="true" />}{index === 1 && <Smartphone size={20} aria-hidden="true" />}{index > 1 && <Check size={20} aria-hidden="true" />}</span>
              <div><span class="benefit-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section process-section" aria-labelledby="process-title">
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Prosty proces</p>
          <h2 id="process-title">Od rozmowy do uruchomienia.</h2>
          <p>Najpierw ustalamy, czego potrzebujesz. Dopiero potem przygotowujemy propozycję zakresu i ceny.</p>
        </div>
        <div class="steps-grid">
          {steps.map(([number, title, description]) => (
            <article class="step" data-reveal><span class="step-number">{number}</span><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>
        <a class="process-link" href="/jak-to-dziala/">Więcej o przebiegu współpracy <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </section>

    {featuredProjects.length > 0 && (
      <section class="section portfolio-section" aria-labelledby="portfolio-title">
        <div class="container">
          <div class="portfolio-heading" data-reveal>
            <div><p class="eyebrow">Kierunki wizualne</p><h2 id="portfolio-title">Zobacz przykładowe koncepcje.</h2><p>To projekty demonstracyjne, nie realizacje zleceń. Każdy jest wyraźnie oznaczony jako koncepcja.</p></div>
            <a class="button button-secondary" href="/realizacje/">Wszystkie dema <ArrowRight size={16} aria-hidden="true" /></a>
          </div>
          <div class="project-grid">
            {featuredProjects.map((project) => (
              <article class="card project-card" data-reveal>
                <a class="project-card-link" href={`/realizacje/${project.slug}/`} aria-label={`Zobacz demonstracyjną koncepcję ${project.name}`}>
                  <ProjectPreview project={project} />
                  <div class="project-info"><div class="project-info-top"><div><span class="eyebrow">{project.category} · Demo</span><h3>{project.name}</h3></div><span class="project-arrow"><ArrowRight size={16} aria-hidden="true" /></span></div><p>{project.description}</p></div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <div class="faq-intro" data-reveal><p class="eyebrow">Najczęstsze pytania</p><h2 id="faq-title">Jasne odpowiedzi przed rozmową.</h2><p>Nie widzisz tego, czego szukasz? Powiedz nam o tym przez telefon lub formularz.</p><a class="text-link" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={16} aria-hidden="true" /></a></div>
        <FAQList items={homeFaqs} />
      </div>
    </section>

    <section class="section final-section" id="kontakt" aria-labelledby="contact-title">
      <div class="container">
        <div class="cta-band" data-reveal>
          <div class="cta-band-inner">
            <div><p class="eyebrow">Zacznijmy od rozmowy</p><h2 id="contact-title">Opowiedz, czego potrzebuje Twoja firma.</h2><p>Możesz poprosić o telefon albo zadzwonić bezpośrednio, jeśli wolisz.</p></div>
            <div class="cta-actions">
              <a class="button" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={17} aria-hidden="true" /></a>
              {site.phone && <a class="direct-call" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}><PhoneCall size={16} aria-hidden="true" /> Zadzwoń: {site.phone}</a>}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .offer-section { background: var(--surface); }
  .benefit-section { background: var(--forest); color: var(--surface); }
  .benefit-section .eyebrow { color: var(--lime); }
  .benefit-section .benefit-intro h2 { color: var(--surface); }
  .benefit-section .benefit-intro > p:not(.eyebrow), .benefit-section .benefit-row p { color: rgba(251,249,242,.76); }
  .benefit-section .text-link { color: var(--lime); }
  .benefit-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 10vw, 8rem); align-items: start; }
  .benefit-intro { position: sticky; top: 8rem; }
  .benefit-intro h2, .faq-intro h2 { max-width: 12ch; margin-bottom: 1rem; font-size: clamp(2.2rem, 4.2vw, 3.7rem); line-height: 1.02; letter-spacing: -.065em; }
  .benefit-intro > p:not(.eyebrow), .faq-intro > p:not(.eyebrow) { max-width: 440px; color: var(--muted); }
  .text-link, .process-link { display: inline-flex; align-items: center; gap: .5rem; color: var(--accent-dark); font-size: .9rem; font-weight: 720; text-decoration: none; }
  .text-link:hover, .process-link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .benefit-list { border-top: 1px solid rgba(251,249,242,.25); }
  .benefit-row { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; padding: 1.6rem 0; border-bottom: 1px solid rgba(251,249,242,.25); }
  .benefit-icon { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border: 1px solid var(--lime); background: var(--lime); color: var(--forest); }
  .benefit-number { color: rgba(251,249,242,.62); font-size: .7rem; font-weight: 700; letter-spacing: .1em; }
  .benefit-row h3 { margin: .2rem 0 .4rem; font-size: 1.17rem; letter-spacing: -.03em; }
  .benefit-row p { max-width: 520px; margin: 0; color: var(--muted); font-size: .9rem; }
  .process-section { background: var(--surface-soft); }
  .process-section .section-heading { max-width: 650px; }
  .process-link { margin-top: 2rem; }
  .portfolio-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .portfolio-heading > div { max-width: 680px; }
  .portfolio-heading h2 { margin: 0 0 .75rem; font-size: clamp(2rem, 4.2vw, 3.5rem); line-height: 1.05; letter-spacing: -.06em; }
  .portfolio-heading p:not(.eyebrow) { margin: 0; color: var(--muted); }
  .portfolio-heading .button { flex-shrink: 0; }
  .portfolio-section .project-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; gap: 1.25rem; }
  .portfolio-section .project-card:nth-child(1) { grid-column: span 7; }
  .portfolio-section .project-card:nth-child(2) { grid-column: span 5; margin-top: 5rem; }
  .portfolio-section .project-card:nth-child(3) { grid-column: 4 / span 6; margin-top: -1.5rem; }
  .portfolio-section .project-card:nth-child(1) .project-preview { min-height: 320px; }
  .portfolio-section .project-card:nth-child(2) .project-preview { min-height: 245px; }
  .portfolio-section .project-card:nth-child(3) .project-preview { min-height: 275px; }
  .faq-section { background: var(--surface); }
  .faq-layout { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .faq-intro { position: sticky; top: 8rem; }
  .final-section { padding-top: 1rem; }
  .cta-actions { display: grid; justify-items: start; gap: .8rem; }
  .cta-band .direct-call { display: inline-flex; align-items: center; gap: .45rem; color: var(--surface); font-size: .88rem; font-weight: 650; text-decoration: none; }
  .cta-band .direct-call:hover { text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 850px) {
    .benefit-grid, .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .benefit-intro, .faq-intro { position: static; }
    .benefit-intro h2, .faq-intro h2 { max-width: 15ch; }
  }
  @media (max-width: 640px) {
    .portfolio-heading { align-items: flex-start; flex-direction: column; }
    .cta-actions { width: 100%; }
    .cta-actions .button { width: 100%; }
  }
  @media (max-width: 850px) {
    .portfolio-section .project-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .portfolio-section .project-card:nth-child(1) { grid-column: span 4; }
    .portfolio-section .project-card:nth-child(2) { grid-column: span 2; margin-top: 3rem; }
    .portfolio-section .project-card:nth-child(3) { grid-column: 2 / span 4; margin-top: -1rem; }
  }
  @media (max-width: 640px) {
    .portfolio-section .project-grid { grid-template-columns: 1fr; }
    .portfolio-section .project-card:nth-child(1), .portfolio-section .project-card:nth-child(2), .portfolio-section .project-card:nth-child(3) { grid-column: auto; margin-top: 0; }
    .portfolio-section .project-card .project-preview { min-height: 230px; }
  }
</style>
