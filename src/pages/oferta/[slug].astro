---
import { ArrowRight, Check } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { offers } from '../../data/offers';
import FAQList from '../../components/FAQList.astro';
import { offerFaqs } from '../../data/faq';

export function getStaticPaths() {
  return offers.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props;
const title = `${offer.name} — oferta`;
const description = `${offer.summary} Sprawdź zakres i porozmawiajmy o wycenie.`;
const planningDetails = [
  'Dokładny zakres, cena i etapy współpracy',
  'Potrzebne materiały i sposób akceptacji',
  'Domena, hosting, uruchomienie i ewentualne koszty zewnętrzne',
];
---

<BaseLayout title={title} description={description} canonicalPath={`/oferta/${offer.slug}/`}>
  <main id="main">
    <section class="section hero">
      <div class="container">
        <a class="back-link" href="/oferta/">← Wszystkie oferty</a>
        <div class="hero-grid">
          <div>
            <p class="eyebrow">Oferta</p>
            <h1 class="display">{offer.name}</h1>
            <p class="lead">{offer.summary}</p>
            <p class="audience"><strong>Dla kogo:</strong> {offer.audience}</p>
            <p class="result"><strong>Rezultat:</strong> {offer.result}</p>
            <a class="button button-primary" href={`/kontakt/?pakiet=${offer.slug}#formularz`}>Jestem zainteresowany <ArrowRight size={16} aria-hidden="true" /></a>
          </div>
          <aside class="price-card card">
            <p class="eyebrow">Wycena</p>
            <p class="price">{offer.priceLabel}</p>
            <p class="muted">Najpierw poznajemy potrzeby. Zakres i cenę przedstawiamy do akceptacji przed rozpoczęciem prac.</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="section scope-section">
      <div class="container scope-grid">
        <section aria-labelledby="scope-heading">
          <p class="eyebrow">Ustalony zakres</p><h2 id="scope-heading">Co obejmuje oferta</h2>
          <ul class="feature-list">{offer.scope.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}</ul>
        </section>
        <section class="planning-card" aria-labelledby="planning-heading">
          <p class="eyebrow">Przed rozpoczęciem</p><h2 id="planning-heading">Ustalamy szczegóły</h2>
          <ul class="feature-list">{planningDetails.map((item) => <li><span aria-hidden="true">→</span>{item}</li>)}</ul>
          <p class="muted note">Liczba elementów, potrzebne funkcje i terminy zależą od projektu; potwierdzamy je w propozycji przed rozpoczęciem prac.</p>
        </section>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div><p class="eyebrow">Ważne informacje</p><h2>Pytania o ofertę</h2><p class="muted">Pełny przegląd opcji znajdziesz na stronie <a href="/oferta/">oferty</a>.</p></div>
        <FAQList items={offerFaqs} name="Pytania o ofertę" />
      </div>
    </section>

    <section class="section contact-section"><div class="container contact-card"><div><p class="eyebrow">Masz pytania?</p><h2>Ustalmy zakres i wycenę.</h2><p>Poproś o telefon — to prośba o kontakt, a nie zamówienie.</p></div><a class="button button-primary" href={`/kontakt/?pakiet=${offer.slug}#formularz`}>Poproś o telefon <ArrowRight size={16} aria-hidden="true" /></a></div></section>
  </main>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 7rem); }
  .back-link { color: var(--muted); text-underline-offset: .25em; display: inline-block; margin-bottom: 2.5rem; }
  .hero-grid, .scope-grid, .faq-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(17rem, .8fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  h1 { font-size: clamp(3rem, 8vw, 6.5rem); line-height: .98; letter-spacing: -.055em; margin: .5rem 0 1rem; }
  h2 { font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; letter-spacing: -.04em; margin: .5rem 0 1.5rem; }
  .lead { max-width: 40rem; font-size: 1.2rem; line-height: 1.7; color: var(--muted); }
  .audience, .result { max-width: 42rem; line-height: 1.65; }
  .price-card { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .price { margin: .5rem 0 1rem; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 750; letter-spacing: -.04em; }
  .price-card > .muted { line-height: 1.6; }
  .scope-section, .faq-section { background: var(--surface); }
  .scope-grid { align-items: start; }
  .feature-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .feature-list li { display: flex; gap: .75rem; line-height: 1.6; }
  .feature-list svg, .feature-list li span { flex: 0 0 1.2rem; color: var(--accent-dark); }
  .planning-card { padding-left: clamp(1.25rem, 4vw, 3rem); border-left: 1px solid var(--line); }
  .note { margin-top: 1.5rem; font-size: .95rem; line-height: 1.6; }
  .faq-layout { align-items: start; }
  .faq-layout a { color: inherit; }
  .contact-card { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(2rem, 5vw, 4rem); background: var(--forest); color: var(--paper); }
  .contact-card h2 { max-width: 15ch; }
  .contact-card p:not(.eyebrow) { color: color-mix(in srgb, var(--paper), transparent 25%); }
  .contact-card .eyebrow { color: var(--lime); }
  @media (max-width: 760px) { .hero-grid, .scope-grid, .faq-layout { grid-template-columns: 1fr; } .planning-card { border-left: 0; border-top: 1px solid var(--line); padding: 2rem 0 0; } }
  @media (max-width: 520px) { .contact-card { align-items: flex-start; flex-direction: column; } }
</style>
