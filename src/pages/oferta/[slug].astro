---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { packages } from "../../data/packages";
import FAQList from "../../components/FAQList.astro";
import { offerFaqs } from "../../data/faq";

export function getStaticPaths() {
  return packages.map((item) => ({ params: { slug: item.slug }, props: { package: item } }));
}

const { package: offer } = Astro.props;
const title = `${offer.name} — pakiet strony internetowej`;
const description = `${offer.summary} Sprawdź dla kogo jest pakiet ${offer.name}, jego zakres, wyłączenia i opcje dodatkowe.`;
const formatPrice = (amount: number) => amount.toLocaleString("pl-PL");
---

<BaseLayout title={title} description={description} canonicalPath={`/oferta/${offer.slug}/`}>
  <main id="main">
    <section class="section hero">
      <div class="container">
        <a class="back-link" href="/oferta/">← Wszystkie pakiety</a>
        <div class="hero-grid">
          <div>
            <p class="eyebrow">Pakiet strony internetowej</p>
            <h1 class="display">{offer.name}</h1>
            <p class="lead">{offer.summary}</p>
            <p class="audience"><strong>Dla kogo:</strong> {offer.audience}</p>
            <a class="button button-primary" href={`/kontakt/?pakiet=${offer.slug}`}>Zapytaj o ten pakiet</a>
          </div>
          <aside class="price-card card">
            <p class="eyebrow">Cena bazowego zakresu</p>
            <p class="price">od {formatPrice(offer.priceFrom)} <span>zł</span></p>
            <p class="muted">Ostateczna wycena zależy od uzgodnionego zakresu. Dodatkowe prace przedstawimy do akceptacji.</p>
            <div class="rounds"><span aria-hidden="true">↻</span><strong>{offer.revisionRounds} {offer.revisionRounds === 1 ? "runda" : offer.revisionRounds >= 2 && offer.revisionRounds <= 4 ? "rundy" : "rund"} poprawek</strong></div>
          </aside>
        </div>
      </div>
    </section>

    <section class="section scope-section">
      <div class="container scope-grid">
        <section aria-labelledby="included-heading">
          <p class="eyebrow">Zakres pakietu</p><h2 id="included-heading">Co otrzymujesz</h2>
          <ul class="feature-list included">{offer.included.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </section>
        <section class="excluded" aria-labelledby="excluded-heading">
          <p class="eyebrow">Dla jasności</p><h2 id="excluded-heading">Poza zakresem</h2>
          <ul class="feature-list">{offer.notIncluded.map((item) => <li><span aria-hidden="true">−</span>{item}</li>)}</ul>
          <p class="muted note">Możemy omówić dodatkowe potrzeby i przygotować osobną wycenę.</p>
        </section>
      </div>
    </section>

    <section class="section extensions-section">
      <div class="container extension-grid">
        <div><p class="eyebrow">Możliwe rozszerzenia</p><h2>Rozbuduj zakres według potrzeb</h2><p class="muted">Poniższe elementy nie są automatycznie częścią pakietu. Ustalimy ich dostępność, zakres i cenę przed rozpoczęciem prac.</p></div>
        <ul class="extension-list">{offer.extensions.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div><p class="eyebrow">Ważne informacje</p><h2>Pytania o pakiet</h2><p class="muted">Pełny przegląd opcji znajdziesz na stronie <a href="/oferta/">oferty</a>.</p></div>
        <FAQList items={offerFaqs} name="Pytania o pakiety" />
      </div>
    </section>

    <section class="section contact-section"><div class="container contact-card"><div><p class="eyebrow">Masz pytania?</p><h2>Uzgodnijmy szczegóły.</h2><p>Bez zobowiązań porozmawiamy o zakresie i dopasowaniu pakietu.</p></div><a class="button button-primary" href={`/kontakt/?pakiet=${offer.slug}`}>Zapytaj o pakiet {offer.name}</a></div></section>
  </main>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 7rem); }
  .back-link { color: var(--muted); text-underline-offset: .25em; display: inline-block; margin-bottom: 2.5rem; }
  .hero-grid, .scope-grid, .extension-grid, .faq-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(17rem, .8fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  h1 { font-size: clamp(3rem, 8vw, 6.5rem); line-height: .98; letter-spacing: -.055em; margin: .5rem 0 1rem; }
  h2 { font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; letter-spacing: -.04em; margin: .5rem 0 1.5rem; }
  .lead { max-width: 40rem; font-size: 1.2rem; line-height: 1.7; color: var(--muted); }
  .audience { margin: 1.5rem 0 2rem; max-width: 42rem; line-height: 1.6; }
  .price-card { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .price { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 750; letter-spacing: -.05em; margin: .4rem 0; }
  .price span { font-size: .55em; }
  .price-card > .muted { line-height: 1.6; }
  .rounds { display: flex; gap: .7rem; align-items: center; padding-top: 1.2rem; margin-top: 1.2rem; border-top: 1px solid var(--line); }
  .rounds span { color: var(--accent); font-size: 1.3rem; }
  .scope-section, .faq-section { background: var(--surface); }
  .scope-grid { align-items: start; }
  .feature-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .feature-list li { display: flex; gap: .75rem; line-height: 1.6; }
  .feature-list li span { flex: 0 0 1.2rem; color: var(--accent-dark); font-weight: 800; }
  .excluded { border-left: 1px solid var(--line); padding-left: clamp(1.25rem, 4vw, 3rem); }
  .excluded .feature-list li span { color: var(--muted); }
  .note { margin-top: 1.5rem; font-size: .95rem; line-height: 1.6; }
  .extension-grid { align-items: start; }
  .extension-grid > div > p:not(.eyebrow) { line-height: 1.7; }
  .extension-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .extension-list li { border: 1px solid var(--line); border-radius: .85rem; padding: 1rem; line-height: 1.5; }
  .faq-layout { align-items: start; }
  .faq-layout a { color: inherit; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); padding: 1.25rem 0; }
  summary { cursor: pointer; font-weight: 650; }
  details p { color: var(--muted); line-height: 1.7; margin: .9rem 0 0; max-width: 48rem; }
  .contact-card { display: flex; justify-content: space-between; align-items: center; gap: 2rem; border-radius: 1.5rem; padding: clamp(2rem, 5vw, 4rem); background: var(--ink); color: var(--paper); }
  .contact-card h2 { max-width: 15ch; }
  .contact-card p:not(.eyebrow) { color: color-mix(in srgb, var(--paper), transparent 25%); }
  .contact-card .eyebrow { color: var(--accent); }
  @media (max-width: 760px) { .hero-grid, .scope-grid, .extension-grid, .faq-layout { grid-template-columns: 1fr; } .excluded { border-left: 0; border-top: 1px solid var(--line); padding: 2rem 0 0; } }
  @media (max-width: 520px) { .extension-list { grid-template-columns: 1fr; } .contact-card { align-items: flex-start; flex-direction: column; } }
</style>
