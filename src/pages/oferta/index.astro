---
import { ArrowRight, Check } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfferCard from '../../components/OfferCard.astro';
import { offers } from '../../data/offers';
import FAQList from '../../components/FAQList.astro';
import { additionalServices, offerFaqs } from '../../data/faq';

const title = 'Oferta stron i prostych aplikacji';
const description = 'Zobacz, jak możemy pomóc z firmową stroną lub prostą aplikacją. Zakres i cenę ustalamy przed rozpoczęciem prac.';
---

<BaseLayout title={title} description={description} canonicalPath="/oferta/">
  <main id="main">
    <section class="section intro">
      <div class="container intro-grid">
        <div>
          <p class="eyebrow">Oferta</p>
          <h1 class="display">Strona albo narzędzie. <span>Ty wybierasz cel.</span></h1>
          <p class="lead">Pomagamy małym firmom pokazać ofertę albo uprościć konkretny proces. Nie musisz znać technologii — wystarczy, że opowiesz nam, czego potrzebujesz.</p>
          <div class="actions"><a class="button button-primary" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={16} aria-hidden="true" /></a><a class="text-link" href="#oferty">Zobacz dwie oferty <span aria-hidden="true">↓</span></a></div>
        </div>
        <aside class="scope card" aria-label="Co obejmuje współpraca">
          <p class="eyebrow">Od rozmowy po uruchomienie</p>
          <ul>
            <li><Check size={17} aria-hidden="true" /> Pomoc z treścią i materiałami</li>
            <li><Check size={17} aria-hidden="true" /> Uzgodniony zakres i cena</li>
            <li><Check size={17} aria-hidden="true" /> Wsparcie z domeną i hostingiem</li>
            <li><Check size={17} aria-hidden="true" /> Publikacja zaakceptowanego rozwiązania</li>
          </ul>
          <p class="muted small">Zajmujemy się wyborem i konfiguracją domeny oraz hostingu w uzgodnionym zakresie. Domenę rejestrujemy na dane klienta jako abonenta; koszty usług zewnętrznych omawiamy przed startem.</p>
        </aside>
      </div>
    </section>

    <section class="section offers-section" id="oferty">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Punkt wyjścia do rozmowy</p>
          <h2>Dwie oferty, zakres ustalamy razem.</h2>
          <p>Obie propozycje są punktem wyjścia. Potrzebny zakres i cenę ustalamy po rozmowie.</p>
        </div>
        <div class="offer-grid">
          {offers.map((offer) => <OfferCard offer={offer} />)}
        </div>
      </div>
    </section>

    <section class="section extras-section">
      <div class="container extras-grid">
        <div><p class="eyebrow">W razie potrzeby</p><h2>Możemy ustalić także dalszą pomoc.</h2><p class="muted">Dodatkowe prace omawiamy osobno. Przed rozpoczęciem poznasz ich zakres i cenę.</p></div>
        <div class="extras-list">
          {additionalServices.map((service) => <article><h3>{service.title}</h3><p>{service.description}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div><p class="eyebrow">Koszty i zakres</p><h2>Najczęstsze pytania</h2><p class="muted">Nie widzisz odpowiedzi? <a href="/kontakt/#formularz">Poproś o telefon</a>.</p></div>
        <FAQList items={offerFaqs} name="Pytania o ofertę i koszty" />
      </div>
    </section>

    <section class="section final-section"><div class="container final-card"><div><p class="eyebrow">Kolejny krok</p><h2>Opowiedz, czego potrzebuje Twoja firma.</h2><p>Wspólnie ustalimy sensowny zakres i cenę. Sam kontakt niczego nie zamawia.</p></div><a class="button button-primary" href="/kontakt/#formularz">Poproś o telefon <ArrowRight size={16} aria-hidden="true" /></a></div></section>
  </main>
</BaseLayout>

<style>
  .intro { padding-block: clamp(4rem, 9vw, 8rem); }
  .intro-grid, .extras-grid, .faq-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(17rem, .8fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  h1 { max-width: 13ch; margin: .45rem 0 1.25rem; font-size: clamp(3rem, 7vw, 6.4rem); line-height: .99; letter-spacing: -.055em; }
  h1 span { color: var(--accent); }
  h2 { margin: .5rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.04em; line-height: 1.05; }
  .lead { max-width: 42rem; color: var(--muted); font-size: 1.15rem; line-height: 1.7; }
  .actions { display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; margin-top: 2rem; }
  .text-link { color: var(--ink); font-weight: 650; text-underline-offset: .25em; }
  .scope { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .scope ul { margin: 1.5rem 0; padding: 0; list-style: none; display: grid; gap: 1rem; }
  .scope li { display: flex; gap: .8rem; align-items: flex-start; }
  .scope li svg { flex: 0 0 auto; color: var(--accent); }
  .small { font-size: .9rem; line-height: 1.6; }
  .offers-section, .faq-section { background: var(--surface); }
  .extras-grid { align-items: start; }
  .extras-list { display: grid; gap: 1rem; }
  .extras-list article { padding: 1.25rem 1.5rem; border: 1px solid var(--line); background: var(--surface); }
  .extras-list h3 { margin: 0 0 .5rem; font-size: 1.1rem; }
  .extras-list p { margin: 0; color: var(--muted); line-height: 1.65; }
  .faq-layout { align-items: start; }
  .faq-layout a { color: inherit; }
  .final-section { padding-top: 1rem; }
  .final-card { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(2rem, 5vw, 4rem); background: var(--forest); color: var(--paper); }
  .final-card h2 { max-width: 15ch; }
  .final-card p:not(.eyebrow) { color: color-mix(in srgb, var(--paper), transparent 25%); }
  .final-card .eyebrow { color: var(--lime); }
  @media (max-width: 800px) { .intro-grid, .extras-grid, .faq-layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .final-card { align-items: flex-start; flex-direction: column; } .actions { align-items: flex-start; flex-direction: column; } }
</style>
